# ==============================================================================
# SPL DETECTION: Reconnaissance & Process Execution Correlation
# Project: P5 — Network Threat Detection with Splunk
# Status: Verified Production Query (Sysmon Event ID 3 & Event ID 1)
# ==============================================================================
#
# PURPOSE:
#   Correlate incoming port probes with follow-up process executions
#   or outbound callback traffic, identifying reconnaissance transitioning to exploitation.
# ==============================================================================

index=sysmon earliest=-4h
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| search EventID=3 OR EventID=1
| rex field=_raw "<Data Name=['\"]SourceIp['\"]>(?<src_ip>[^<]+)</Data>"
| rex field=_raw "<Data Name=['\"]Image['\"]>(?<process_name>[^<]+)</Data>"
| rex field=_raw "<Data Name=['\"]CommandLine['\"]>(?<cmdline>[^<]+)</Data>"
| eval event_type=if(EventID==3, "NETWORK_CONNECTION", "PROCESS_CREATION")
| table _time, event_type, src_ip, process_name, cmdline
| sort - _time
