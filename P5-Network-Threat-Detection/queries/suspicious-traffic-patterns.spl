# --- CANDIDATE TEMPLATE: Traffic Profiling ---
# index=sysmon earliest=-24h
# | rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
# | search EventID=3
# | rex field=_raw "DestinationIp\">(?<dest_ip>[^<]+)</Data>"
# | rex field=_raw "DestinationPort\">(?<dest_port>\d+)</Data>"
# | rex field=_raw "Image\">(?<process_path>[^<]+)</Data>"
# | stats count as total_connections, dc(dest_port) as distinct_ports by dest_ip, process_path
# | sort - total_connections
