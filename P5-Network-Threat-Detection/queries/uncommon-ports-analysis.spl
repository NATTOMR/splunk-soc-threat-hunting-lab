# ==============================================================================
# SPL DETECTION: Connections to Uncommon / Suspicious Ports
# Project: P5 — Network Threat Detection with Splunk
# Status: Verified Production Query (Sysmon Event ID 3)
# ==============================================================================
#
# PURPOSE:
#   Filter out standard service ports and isolate connections to non-standard,
#   ephemeral, or known backdoor ports (e.g. 4444, 1337, 8888).
# ==============================================================================

index=sysmon earliest=-24h
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| search EventID=3
| rex field=_raw "<Data Name=['\"]DestinationPort['\"]>(?<dest_port>\d+)</Data>"
| rex field=_raw "<Data Name=['\"]DestinationIp['\"]>(?<dest_ip>[^<]+)</Data>"
| rex field=_raw "<Data Name=['\"]SourceIp['\"]>(?<src_ip>[^<]+)</Data>"
| rex field=_raw "<Data Name=['\"]Image['\"]>(?<process_path>[^<]+)</Data>"
| search NOT dest_port IN (80, 443, 53, 88, 389, 445, 135, 139, 22, 3389, 8089, 9997, 18000, 47001)
| stats count as probe_count, values(process_path) as initiating_processes by dest_port, dest_ip, src_ip
| sort - probe_count
