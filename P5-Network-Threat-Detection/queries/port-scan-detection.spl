# ==============================================================================
# SPL DETECTION: Port Scanning & Network Reconnaissance
# Project: P5 — Network Threat Detection with Splunk
# Status: Verified Production Query (Sysmon Event ID 3)
# ==============================================================================
#
# PURPOSE:
#   Detect horizontal or vertical port scanning activity by aggregating
#   distinct destination ports per source IP within a rolling time window.
# ==============================================================================

index=sysmon earliest=-1h
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| search EventID=3
| rex field=_raw "<Data Name=['\"]SourceIp['\"]>(?<src_ip>[^<]+)</Data>"
| rex field=_raw "<Data Name=['\"]DestinationIp['\"]>(?<dest_ip>[^<]+)</Data>"
| rex field=_raw "<Data Name=['\"]DestinationPort['\"]>(?<dest_port>\d+)</Data>"
| stats count as connection_attempts, dc(dest_port) as unique_ports_scanned, values(dest_port) as sampled_ports by src_ip, dest_ip
| where unique_ports_scanned >= 2
| sort - unique_ports_scanned
