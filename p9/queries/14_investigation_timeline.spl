# ==============================================================================
# SPL Query: 14_investigation_timeline.spl
# Project: P9 — Splunk SOC Dashboard
# Purpose: Unified chronological SOC investigation event stream. Correlates timestamp,
#          source IP, target identity, event type, detection rule name, assigned
#          severity, and MITRE ATT&CK technique for end-to-end incident reconstruction.
# Author: Natto Chakma
# Telemetry: index=windows, index=sysmon, index=linux_security, index=web, index=email
# ==============================================================================

(index=windows (EventCode=4624 OR EventCode=4625 OR EventCode=4672 OR EventCode=4728 OR EventCode=7045) earliest=-7d)
OR (index=sysmon earliest=-7d)
OR (index=linux_security earliest=-7d)
OR (index=web sourcetype=access_combined earliest=-7d)
OR (index=email sourcetype="postfix:syslog" earliest=-7d)
| rex field=_raw "<EventID>(?<SysmonEventID>\d+)</EventID>"
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]+)</Data>"
| rex field=_raw "<Data Name='CommandLine'>(?<CommandLine>[^<]*)</Data>"
| rex field=_raw "<Data Name='SourceIp'>(?<sysmon_src_ip>[^<]+)</Data>"
| rex field=_raw "from (?<linux_src_ip>\d+\.\d+\.\d+\.\d+)"
| rex field=_raw "Failed password for (?:invalid user )?(?<linux_fail_user>[^\s]+)"
| rex field=_raw "Accepted \w+ for (?<linux_succ_user>[^\s]+)"
| rex field=_raw "(?<sudo_user>\w+)\s*:\s*TTY=[^\s]+\s*;\s*COMMAND=(?<sudo_cmd>.*)"
| eval SourceIP=coalesce(clientip, IpAddress, sysmon_src_ip, linux_src_ip, SourceNetworkAddress, src_ip, "N/A")
| eval TargetAccount=lower(coalesce(TargetUserName, linux_fail_user, linux_succ_user, sudo_user, user, Account_Name, "N/A"))
| eval event_triage=case(
    # Web Layer
    match(uri_query, "(?i)(union(\s+|\/\*.*\*\/)+select)"), "Web Attack: SQL Injection",
    match(uri_query, "(?i)(<script|javascript:)"), "Web Attack: Cross-Site Scripting",
    match(uri_path, "(?i)(\.\./|/etc/passwd)"), "Web Attack: Path Traversal",
    match(useragent, "(?i)(nikto|sqlmap|nmap)"), "Web Recon: Automated Security Scanner",
    
    # Endpoint / Process Layer
    match(CommandLine, "(?i)powershell.*-(e|en|enc|encodedcommand)\s+"), "Endpoint Threat: Obfuscated PowerShell Dropper",
    match(CommandLine, "(?i)(certutil.*-urlcache|bitsadmin.*(/transfer|/create))"), "Endpoint Threat: LOLBin Ingress Tool Transfer",
    match(CommandLine, "(?i)schtasks.*create"), "Persistence: Scheduled Task Created via CLI",
    SysmonEventID IN (12,13) AND match(_raw, "(?i)\\\\Run\\\\"), "Persistence: Registry Autostart Run Key Modified",
    SysmonEventID=22 AND match(_raw, "(?i)duckdns\.org"), "C2 Egress: Dynamic DNS Query Lookup",
    
    # Authentication Layer
    EventCode=4625, "Authentication: Windows Logon Failure",
    isnotnull(linux_fail_user), "Authentication: Linux SSH Logon Failure",
    EventCode=4624 AND Logon_Type="9", "Privilege Escalation: Pass-The-Hash / NewCredentials",
    EventCode IN (4728, 4732), "Privilege Escalation: User Added to Administrative Group",
    isnotnull(sudo_cmd) AND match(sudo_cmd, "(?i)(/bin/bash|/bin/sh|python|vi|find)\b"), "Privilege Escalation: Sudo GTFOBins Shell Spawn",
    isnotnull(sudo_cmd), "Administrative: Sudo Command Executed",
    EventCode=7045, "Persistence: New Windows Service Registered",
    EventCode=4624, "Authentication: Successful Windows Logon",
    isnotnull(linux_succ_user), "Authentication: Successful Linux SSH Logon",
    true(), "Other Monitored Security Event"
  )
| search event_triage!="Other Monitored Security Event" AND event_triage!="Authentication: Successful Windows Logon"
| eval Severity=case(
    match(event_triage, "(?i)(SQL Injection|Pass-The-Hash|Obfuscated PowerShell|Administrative Group)"), "CRITICAL",
    match(event_triage, "(?i)(Cross-Site|Path Traversal|LOLBin|Persistence|Service Registered|Sudo GTFOBins)"), "HIGH",
    match(event_triage, "(?i)(Scanner|Logon Failure|Dynamic DNS|Sudo Command)"), "MEDIUM",
    true(), "LOW"
  )
| eval MITRE_Technique=case(
    match(event_triage, "(?i)SQL Injection|Cross-Site|Path Traversal"), "T1190: Exploit Public-Facing App",
    match(event_triage, "(?i)Scanner"), "T1595.002: Vulnerability Scanning",
    match(event_triage, "(?i)Obfuscated PowerShell"), "T1059.001: PowerShell",
    match(event_triage, "(?i)LOLBin"), "T1105: Ingress Tool Transfer / T1218",
    match(event_triage, "(?i)Scheduled Task"), "T1053.005: Scheduled Task",
    match(event_triage, "(?i)Registry Autostart"), "T1547.001: Registry Run Keys",
    match(event_triage, "(?i)Dynamic DNS"), "T1071.004: DNS",
    match(event_triage, "(?i)Logon Failure"), "T1110: Brute Force",
    match(event_triage, "(?i)Pass-The-Hash"), "T1550.002: Pass the Hash",
    match(event_triage, "(?i)Administrative Group"), "T1098: Account Manipulation",
    match(event_triage, "(?i)Sudo GTFOBins"), "T1548.003: Sudo Caching",
    match(event_triage, "(?i)Service Registered"), "T1543.003: Windows Service",
    true(), "N/A"
  )
| eval Activity_Detail=coalesce(CommandLine, uri_query, uri_path, sudo_cmd, _raw)
| table _time, Severity, event_triage, MITRE_Technique, SourceIP, TargetAccount, host, Activity_Detail
| eval _time=strftime(_time, "%Y-%m-%d %H:%M:%S")
| sort - _time
