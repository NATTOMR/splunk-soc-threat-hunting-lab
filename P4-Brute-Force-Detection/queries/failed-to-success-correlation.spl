# ==============================================================================
# SPL DETECTION QUERY: Failed-to-Success Authentication Correlation
# Project: P4 — Brute-Force Detection & Investigation
# Status: ✅ Verified against live lab telemetry (ubuntu-p3)
# ==============================================================================
#
# PURPOSE:
#   Correlate authentication failures with subsequent successful logins
#   to detect compromised credentials and successful brute-force breaches.
#
# VERIFIED LAB OUTCOME:
#   Identified 13 failure events originating from 192.168.100.7 alongside
#   verified legitimate access for user "natto" from 192.168.100.1.
# ==============================================================================

index=linux_security sourcetype=linux_secure ("Failed password" OR "Accepted")
| rex "Failed password for (invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| rex "Accepted \S+ for (?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| eval is_fail=if(match(_raw, "Failed password"), 1, 0)
| eval is_succ=if(match(_raw, "Accepted"), 1, 0)
| stats sum(is_fail) as failure_count, sum(is_succ) as success_count, earliest(_time) as first_seen, latest(_time) as last_seen by src_ip, username
| eval alert_severity=case(failure_count >= 3 AND success_count >= 1, "CRITICAL: Potential Account Breach", failure_count >= 5, "HIGH: Active Brute-Force", true(), "LOW")
| convert ctime(first_seen) ctime(last_seen)
| table alert_severity src_ip username failure_count success_count first_seen last_seen
| sort - failure_count
