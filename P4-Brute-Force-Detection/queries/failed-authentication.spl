# ==============================================================================
# SPL DETECTION QUERY: Failed Authentication Analysis
# Project: P4 — Brute-Force Detection & Investigation
# Status: ✅ Verified against live lab telemetry (ubuntu-p3)
# ==============================================================================
#
# PURPOSE:
#   Extract, parse, and normalize authentication events (both failures and
#   successes) across monitored endpoints. Validated on Linux auth.log
#   (sourcetype=linux_secure) and Windows Security Event Logs (EventID 4625/4624).
#
# VERIFIED LAB FIELDS:
#   - Index: index=linux_security
#   - Sourcetype: sourcetype=linux_secure
#   - Target Host: ubuntu-p3 (192.168.100.9)
#   - Offending Source IP: 192.168.100.7 (wazuh-server)
#   - Extracted Fields: username, src_ip, auth_status
# ==============================================================================

# --- PRODUCTION VERIFIED QUERY (Linux SSH Telemetry) ---
index=linux_security sourcetype=linux_secure ("Failed password" OR "Accepted")
| rex "Failed password for (invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| rex "Accepted \S+ for (?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| eval auth_status=if(match(_raw, "Accepted"), "SUCCESS", "FAILURE")
| table _time host src_ip username auth_status _raw
| sort - _time

# --- WINDOWS EVENT LOG TEMPLATE (EventID 4625 / 4624) ---
# index=windows (EventID=4625 OR EventID=4624)
# | rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
# | rex field=_raw "TargetUserName\">(?<username>[^<]+)</Data>"
# | rex field=_raw "IpAddress\">(?<src_ip>[^<]+)</Data>"
# | eval auth_status=if(EventID==4624, "SUCCESS", "FAILURE")
# | table _time host src_ip username auth_status
