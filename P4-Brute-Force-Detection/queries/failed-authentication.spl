# ==============================================================================
# SPL DETECTION TEMPLATE: Failed Authentication Analysis
# Project: P4 — Brute-Force Detection & Investigation
# Status: Candidate Template (Pending Live Telemetry Verification in P4.1)
# ==============================================================================
#
# PURPOSE:
#   Extract and normalize raw failed authentication attempts across monitored
#   endpoints to establish an initial triage feed of failure events.
#
# FIELDS REQUIRING VALIDATION BEFORE EXECUTION:
#   - <INDEX>: Confirm active index (e.g., "windows" or "linux_security")
#   - <SOURCETYPE>: Confirm sourcetype (e.g., "XmlWinEventLog:Security" or "linux_secure")
#   - <EVENT_IDENTIFIER>:
#       * Windows: EventID 4625 (Logon failure). If ingested with renderXml=true,
#         EventID must be extracted using rex from _raw.
#       * Linux: "Failed password" string from auth.log / sshd.
#   - <TARGET_USER>: Target user field (e.g., TargetUserName, Account_Name, or extracted regex)
#   - <SRC_IP>: Source IP address field (e.g., IpAddress, WorkstationName, or extracted regex)
#   - <LOGON_TYPE>: Windows LogonType (e.g., 2=Interactive, 3=Network, 10=RemoteInteractive)
#   - <STATUS_CODE>: SubStatus / Status error code (e.g., 0xC000006A = bad password)
#
# NOTE:
#   Do NOT run assumptions on unverified field names. Validate against active
#   indexer data using `| head 10` during sub-issue P4.1 execution.
#
# ==============================================================================

# --- CANDIDATE TEMPLATE A: Windows Security Event Log (EventID 4625) ---
# Note: When renderXml=true is active, fields must be extracted via rex if not parsed.
#
# index=<WINDOWS_INDEX> earliest=-24h
# | rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
# | search EventID=4625
# | rex field=_raw "TargetUserName\">(?<target_user>[^<]+)</Data>"
# | rex field=_raw "IpAddress\">(?<src_ip>[^<]+)</Data>"
# | rex field=_raw "LogonType\">(?<logon_type>\d+)</Data>"
# | rex field=_raw "Status\">(?<status_code>[^<]+)</Data>"
# | rex field=_raw "SubStatus\">(?<sub_status_code>[^<]+)</Data>"
# | table _time host src_ip target_user logon_type status_code sub_status_code
# | sort - _time

# --- CANDIDATE TEMPLATE B: Linux SSH Authentication Failures (auth.log) ---
#
# index=<LINUX_INDEX> sourcetype=linux_secure "Failed password" earliest=-24h
# | rex "Failed password for (invalid user )?(?<target_user>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
# | table _time host src_ip target_user
# | sort - _time

