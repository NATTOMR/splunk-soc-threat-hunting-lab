# ==============================================================================
# SPL DETECTION QUERY: High-Volume Authentication Failures
# Project: P4 — Brute-Force Detection & Investigation
# Status: ✅ Verified against live lab telemetry (ubuntu-p3)
# ==============================================================================
#
# PURPOSE:
#   Detect burst authentication failure activity exceeding statistical thresholds
#   within a rolling time window (e.g., >= 5 failures in 5 minutes).
#
# VERIFIED ATTACK PATTERN:
#   Detected 13 failures originating from 192.168.100.7 within a 3-minute window.
# ==============================================================================

index=linux_security sourcetype=linux_secure "Failed password"
| rex "Failed password for (invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| bin _time span=5m
| stats count as failure_count, dc(username) as unique_targets, values(username) as targets by _time, src_ip, host
| where failure_count >= 5
| sort - failure_count
