# ==============================================================================
# SPL DETECTION TEMPLATE: Targeted Account Authentication Analysis
# Project: P4 — Brute-Force Detection & Investigation
# Status: Candidate Template (Pending Live Telemetry Verification in P4.1 & P4.2)
# ==============================================================================
#
# PURPOSE:
#   Identify user accounts subject to repeated authentication failures,
#   revealing account-lockout risks, targeted credential guessing, and brute-force
#   focus against privileged accounts (e.g., Administrator, root, service accounts).
#
# FIELDS & PARAMETERS REQUIRING VALIDATION:
#   - <INDEX>: Confirm active index (e.g., "windows" or "linux_security")
#   - <TARGET_USER>: Target account field (to be validated)
#   - <SRC_IP>: Source IP field (to be validated)
#   - <ACCOUNT_FAILURE_THRESHOLD>: Configurable threshold (e.g., count >= 5)
#
# ==============================================================================

# --- CANDIDATE TEMPLATE: Targeted Account Failure Profiling ---
#
# index=<WINDOWS_INDEX> earliest=-24h
# | rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
# | search EventID=4625
# | rex field=_raw "TargetUserName\">(?<target_user>[^<]+)</Data>"
# | rex field=_raw "IpAddress\">(?<src_ip>[^<]+)</Data>"
# | rex field=_raw "SubStatus\">(?<sub_status_code>[^<]+)</Data>"
# | stats count as failure_count, 
#         dc(src_ip) as distinct_sources, 
#         values(src_ip) as source_ips,
#         values(sub_status_code) as error_codes,
#         earliest(_time) as first_failure,
#         latest(_time) as last_failure
#         by target_user
# | where failure_count >= 5
# | eval first_seen = strftime(first_failure, "%Y-%m-%d %H:%M:%S")
# | eval last_seen = strftime(last_failure, "%Y-%m-%d %H:%M:%S")
# | eval attack_vector = if(distinct_sources > 1, "Distributed Guessing", "Single-Source Targeted")
# | table target_user attack_vector failure_count distinct_sources source_ips error_codes first_seen last_seen
# | sort - failure_count
