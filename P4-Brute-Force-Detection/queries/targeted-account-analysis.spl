# ==============================================================================
# SPL DETECTION QUERY: Targeted Account Authentication Analysis
# Project: P4 — Brute-Force Detection & Investigation
# Status: ✅ Verified against live lab telemetry (ubuntu-p3)
# ==============================================================================
#
# PURPOSE:
#   Isolate specific user accounts receiving repeated authentication failures,
#   identifying targeted credential guessing against privileged accounts.
#
# VERIFIED LAB OUTCOME:
#   Identified account "admin" subjected to 4 consecutive failed attempts.
# ==============================================================================

index=linux_security sourcetype=linux_secure "Failed password"
| rex "Failed password for (invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| stats count as failure_count, 
        dc(src_ip) as distinct_sources, 
        values(src_ip) as source_ips,
        earliest(_time) as first_failure,
        latest(_time) as last_failure
        by username
| convert ctime(first_failure) ctime(last_failure)
| table username failure_count distinct_sources source_ips first_failure last_failure
| sort - failure_count
