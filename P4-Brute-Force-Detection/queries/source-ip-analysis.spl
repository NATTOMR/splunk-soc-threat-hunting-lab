# ==============================================================================
# SPL DETECTION TEMPLATE: Source IP Authentication Failure Analysis
# Project: P4 — Brute-Force Detection & Investigation
# Status: Candidate Template (Pending Live Telemetry Verification in P4.1 & P4.2)
# ==============================================================================
#
# PURPOSE:
#   Profile and isolate offending source IP addresses generating authentication
#   failures. Distinguishes between targeted single-account attacks vs distributed
#   or horizontal password spraying (multiple usernames from a single source).
#
# FIELDS & PARAMETERS REQUIRING VALIDATION:
#   - <INDEX>: Confirm active index (e.g., "windows" or "linux_security")
#   - <SRC_IP>: Source IP field (to be validated)
#   - <TARGET_USER>: Target account field (to be validated)
#   - <SPRAY_THRESHOLD>: Distinct user count indicating password spray (e.g., dc(target_user) >= 3)
#
# ==============================================================================

# --- CANDIDATE TEMPLATE: Source IP Profiling (Windows EventID 4625) ---
#
# index=<WINDOWS_INDEX> earliest=-24h
# | rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
# | search EventID=4625
# | rex field=_raw "TargetUserName\">(?<target_user>[^<]+)</Data>"
# | rex field=_raw "IpAddress\">(?<src_ip>[^<]+)</Data>"
# | search src_ip!="-" AND src_ip!="127.0.0.1" AND src_ip!="::1"
# | stats count as total_failures, 
#         dc(target_user) as distinct_targeted_accounts, 
#         values(target_user) as targeted_usernames,
#         earliest(_time) as first_attempt,
#         latest(_time) as last_attempt
#         by src_ip
# | eval attack_duration_sec = last_attempt - first_attempt
# | eval first_seen = strftime(first_attempt, "%Y-%m-%d %H:%M:%S")
# | eval last_seen = strftime(last_attempt, "%Y-%m-%d %H:%M:%S")
# | eval attack_type = if(distinct_targeted_accounts > 3, "Horizontal Password Spray", "Targeted Brute-Force")
# | table src_ip attack_type total_failures distinct_targeted_accounts targeted_usernames attack_duration_sec first_seen last_seen
# | sort - total_failures
