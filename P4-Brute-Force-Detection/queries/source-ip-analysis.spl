# ==============================================================================
# SPL DETECTION QUERY: Source IP Authentication Failure Analysis
# Project: P4 — Brute-Force Detection & Investigation
# Status: ✅ Verified against live lab telemetry (ubuntu-p3)
# ==============================================================================
#
# PURPOSE:
#   Profile offending source IP addresses generating authentication failures.
#   Classifies attack behavior into "Horizontal Password Spray" (>= 3 unique
#   targeted users) vs. "Targeted Brute-Force".
#
# VERIFIED LAB OUTCOME:
#   Identified 192.168.100.7 targeting 8 distinct user accounts.
# ==============================================================================

index=linux_security sourcetype=linux_secure "Failed password"
| rex "Failed password for (invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| stats count as total_failures, 
        dc(username) as distinct_targeted_accounts, 
        values(username) as targeted_usernames,
        earliest(_time) as first_attempt,
        latest(_time) as last_attempt
        by src_ip
| eval attack_type = if(distinct_targeted_accounts >= 3, "Horizontal Password Spray", "Targeted Brute-Force")
| convert ctime(first_attempt) ctime(last_attempt)
| table src_ip attack_type total_failures distinct_targeted_accounts targeted_usernames first_attempt last_attempt
| sort - total_failures
