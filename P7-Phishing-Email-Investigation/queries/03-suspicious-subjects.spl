# ==============================================================================
# SPL Query: 03-suspicious-subjects.spl
# Project: P7 — Phishing Email Investigation with Splunk
# Description: Identifies phishing lures using high-urgency keywords, financial
#              coercion, password expirations, and fake administrative notices.
# Author: Natto Chakma
# MITRE ATT&CK: T1566 (Phishing), T1204 (User Execution)
# ==============================================================================

index=email sourcetype="postfix:syslog"
| rex "postfix/\w+\[\d+\]: (?<queue_id>[A-F0-9]{8,12}):"
| rex "header Subject: (?<subject>.*?) from \w+\["
| rex "header From: (?<sender>.*?) from \w+\["
| rex "header To: (?<recipient>.*?) from \w+\["
| rex "from \w+\[(?<src_ip>\d+\.\d+\.\d+\.\d+)\]"
| rex "(?:body|header)[^:\n]*:.*?(?<url>https?://[^\s>\"\'\)]+)"
| rex "(?<attachment_name>[\w\.\-]+\.(?:exe|xlsm|iso|pdf|vbs))"
| stats 
    values(src_ip) as src_ip
    values(sender) as sender
    values(recipient) as recipient
    values(subject) as subject
    values(attachment_name) as attachment_name
    values(url) as url
    by queue_id
| where isnotnull(sender)
| eval sender=trim(sender, "<> \"'"), recipient=trim(recipient, "<> \"'")
| regex subject="(?i)(urgent|action required|password expirat|wire transfer|overdue|remittance|invoice|delivery notification|package on hold|shared.*sharepoint|mandatory policy|direct deposit|nda signature)"
| eval lure_category=case(
    match(subject, "(?i)(wire transfer|remittance|invoice|overdue|direct deposit)"), "Financial / Wire Fraud / BEC",
    match(subject, "(?i)(password expirat|action required|mandatory policy|account suspended)"), "Credential Harvesting / Administrative Lure",
    match(subject, "(?i)(delivery|package|hold|shipping)"), "Delivery / Logistics Tracking Lure",
    match(subject, "(?i)(sharepoint|onedrive|docusign|nda signature)"), "Cloud Document / Signature Lure",
    true(), "General Phishing Lure"
  )
| stats count as detection_count,
        values(sender) as senders,
        values(recipient) as recipients,
        values(attachment_name) as attachments,
        values(url) as urls
        by lure_category, subject
| sort - detection_count
